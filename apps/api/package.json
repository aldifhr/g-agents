    "@langchain/langgraph": "^1.5.3",
    "@langchain/openai": "^1.8.0",
    "ai": "^7.0.155",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.11.1",
    "postgres": "^3.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "^5"
